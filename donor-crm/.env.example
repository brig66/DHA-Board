# Copy to .env.local for local development. Values are in Supabase:
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SMILES tab: the key created on the DHA website (WordPress > Tools > SMILES Settings
# > Create key). Server-only secret: never give it a NEXT_PUBLIC_ name.
SMILES_API_KEY=
# Optional. Leave empty to use https://dentalhealtharlington.org/wp-json/smiles/v1/summary
SMILES_API_URL=
